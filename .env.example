NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Never use NEXT_PUBLIC_ for AI provider keys.
# Add these variables in Vercel Project Settings.
# Redeploy after changing variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

AI_PRIMARY_PROVIDER=openai
AI_SECONDARY_PROVIDER=gemini
AI_SUPPORT_PRIMARY_PROVIDER=openrouter
AI_SUPPORT_SECONDARY_PROVIDER=groq

ALLOW_FREE_AI_FOR_SUPPORT=true
ALLOW_FREE_AI_FOR_DOCUMENT_REVIEW=false
OPENROUTER_ZDR_REQUIRED=true

AI_MAX_RETRIES=2
AI_TIMEOUT_MS=25000
AI_DAILY_FREE_SUPPORT_LIMIT=10
AI_DAILY_DOCUMENT_REVIEW_LIMIT=3
DEBUG_AI_LOGGING=false
